        </tr>
      
        <tr>
          <td>RTX 4090</td><td>24 GB GDDR6X</td><td class="price-cell">45 000 - 60 000 Kč</td><td><span style="background:#d1fae5;color:#065f46;padding:2px 8px;border-radius:4px;font-size:12px;">retail</span></td><td><span style="color:#92400e;">◐ střední</span></td>
        </tr>
      
        <tr>
          <td>RTX 3090</td><td>24 GB GDDR6X</td><td class="price-cell">18 000 - 25 000 Kč</td><td><span style="background:#fef3c7;color:#92400e;padding:2px 8px;border-radius:4px;font-size:12px;">bazar</span></td><td><span style="color:#92400e;">◐ střední</span></td>
        </tr>
      
        <tr>
