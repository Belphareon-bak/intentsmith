        </tr>
      
        <tr>
          <td>RTX 3080</td><td>10 GB GDDR6X</td><td class="price-cell">12 000 - 18 000 Kč</td><td><span style="background:#fef3c7;color:#92400e;padding:2px 8px;border-radius:4px;font-size:12px;">bazar</span></td><td><span style="color:#92400e;">◐ střední</span></td>
        </tr>
      
        <tr>
          <td>RTX 4070 Ti</td><td>16 GB GDDR6X</td><td class="price-cell">22 000 - 28 000 Kč</td><td><span style="background:#d1fae5;color:#065f46;padding:2px 8px;border-radius:4px;font-size:12px;">retail</span></td><td><span style="color:#92400e;">◐ střední</span></td>
        </tr>
      
        <tr>
          <td>RTX 4070</td><td>12 GB GDDR6</td><td class="price-cell">16 000 - 20 000 Kč</td><td><span style="background:#d1fae5;color:#065f46;padding:2px 8px;border-radius:4px;font-size:12px;">retail</span></td><td><span style="color:#92400e;">◐ střední</span></td>
