{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner-output",
  "title": "Planner Output Contract",
  "description": "The strict output format from the Planner component. No optional fields.",
  "type": "object",
  "required": ["plan_id", "goal", "steps", "requires_approval", "confidence"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique plan identifier (UUID format preferred)"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "What this plan achieves"
    },
    "steps": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/PlannerStep"
      },
      "description": "Ordered list of steps to execute"
    },
    "requires_approval": {
      "type": "boolean",
      "description": "Whether human approval is needed before execution"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score (0-1) that this plan will achieve the goal"
    }
  },
  "$defs": {
    "PlannerStep": {
      "type": "object",
      "required": ["step_id", "action", "tool", "args"],
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique step identifier within this plan"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of what this step does"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "Tool name from ToolRegistry"
        },
        "args": {
          "type": "object",
          "description": "Arguments to pass to the tool"
        }
      }
    }
  }
}
