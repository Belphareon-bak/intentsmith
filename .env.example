# ══════════════════════════════════════════════════════════════════════════════
# C3 Agent — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables are optional — defaults are shown after the = sign.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
C3_PORT=3335
C3_HOST=127.0.0.1
# Comma-separated explicit local HTTP origins, each including its port.
# Empty means same-origin only; wildcards and non-local origins fail closed.
C3_CORS_ORIGINS=

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to 'false' to disable. All enabled by default.
C3_ENABLE_AGENTS=true
C3_ENABLE_LIFECYCLE=true
C3_ENABLE_EXPERTISES=true
C3_ENABLE_TELEMETRY=true

# Online model discovery — JEDINY vypinac mezi produktem a ollama.com/library
# + whatllm.org. Opt-in: zapne se pouze hodnotou "true" (src/config.js:30).
# S vypnutym flagem probiha model discovery jen proti lokalni Ollame.
C3_ENABLE_ONLINE_DISCOVERY=false

# M1 Studio wire — enabled by default after the bounded decision 021 rollout.
# Negotiation remains required-offer, so legacy clients stay on legacy wire.
C3_ENABLE_M1_WIRE=true
# Inline-only attachment policy: 8 items, 6 MiB decoded total, 12 MiB UTF-8 frame.
# Per-item limits remain C3_MAX_TEXT_ATTACHMENT / C3_MAX_IMAGE_ATTACHMENT below.
C3_M1_ATTACHMENT_MAX_COUNT=8
C3_M1_ATTACHMENT_MAX_AGGREGATE_BYTES=6291456
C3_M1_WIRE_MAX_FRAME_BYTES=12582912

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434

# ── Models ───────────────────────────────────────────────────────────────────
# D1: Deep deliberation (analysis, planning, redesign)
C3_MODEL_D1=deepseek-r1:32b
# D2: Fix deliberation (lighter, focused on fixes)
C3_MODEL_D2=qwen3-30b-a3b
# CODE: Implementation (code generation)
C3_MODEL_CODE=qwen3.5:27b
# R1: Final deep review (same brain as D1)
C3_MODEL_R1=deepseek-r1:32b
# R2: Quick review (fast, good at JSON)
C3_MODEL_R2=qwen3.5:27b
# CHAT: General conversation
C3_MODEL_CHAT=qwen3.5:27b
# VISION: Image analysis
C3_MODEL_VISION=llava:13b

# ── Database ─────────────────────────────────────────────────────────────────
C3_DB_PATH=./data/c3.db

# ── Projects ─────────────────────────────────────────────────────────────────
# Default directory for new projects (wizard "auto" mode)
C3_PROJECTS_DIR=./projects

# ── Project Lifecycle ────────────────────────────────────────────────────────
# How often to trigger PROJECT_REVIEW (every N milestones)
C3_LIFECYCLE_REVIEW_FREQ=3
# Max LOC per milestone (context budget)
C3_MAX_MILESTONE_LOC=2000
# Max files per milestone (context budget)
C3_MAX_MILESTONE_FILES=10
# Max retries before milestone is BLOCKED
C3_MAX_MILESTONE_RETRIES=3
# Auto-commit on milestone PASS
C3_LIFECYCLE_AUTO_COMMIT=true

# ── File Handling Limits ───────────────────────────────────────────────────
# Max file size for reading/analysis (bytes, default 1MB)
C3_MAX_FILE_SIZE=1048576
# Max lines displayed from a single file
C3_MAX_DISPLAY_LINES=500
# Max text attachment size from frontend (bytes, default 1MB)
C3_MAX_TEXT_ATTACHMENT=1048576
# Max image attachment size from frontend (bytes, default 5MB)
C3_MAX_IMAGE_ATTACHMENT=5242880
# Max HTTP request body (bytes, default 6MB — must be >= text + image)
C3_MAX_BODY_SIZE=6291456
# Workspace tree max depth
C3_MAX_TREE_DEPTH=5

# ── Logging / Debug ──────────────────────────────────────────────────────────
# debug, info, warn, error
C3_LOG_LEVEL=info
# Set to '1' to enable execution tracing
C3_TRACE=0

# ── Security ─────────────────────────────────────────────────────────────────
# Admin API token (required for /api/agents endpoints)
C3_ADMIN_TOKEN=
# License key
C3_LICENSE_KEY=
# License signing secret
C3_LICENSE_SECRET=

# ── Notifications: Email (SMTP) ─────────────────────────────────────────────
# Retained external channels are OFF unless their value is exactly "true".
C3_ENABLE_NOTIFICATION_EMAIL=false
C3_ENABLE_NOTIFICATION_TELEGRAM=false
C3_ENABLE_NOTIFICATION_PUSH=false
C3_ENABLE_NOTIFICATION_WEBHOOK=false
C3_ENABLE_NOTIFICATION_DESKTOP=false

# Webhook HMAC is operator-owned and read only at process start. Keep the
# install-root .env regular, owner-owned, mode 0600 and free of symlinks; create
# it under umask 077 and restart IntentSmith after changing this value.
C3_WEBHOOK_SECRET=

C3_SMTP_HOST=
C3_SMTP_PORT=587
C3_SMTP_USER=
C3_SMTP_PASS=
C3_SMTP_FROM=

# ── Notifications: Telegram ──────────────────────────────────────────────────
C3_TELEGRAM_BOT_TOKEN=
C3_TELEGRAM_CHAT_ID=

# ── Notifications: ntfy Push ─────────────────────────────────────────────────
C3_NTFY_SERVER=https://ntfy.sh
C3_NTFY_TOPIC=
C3_NTFY_TOKEN=

# ── Auto-Updater ─────────────────────────────────────────────────────────────
C3_UPDATE_REPO=
# Check interval in ms (default: 24h)
C3_UPDATE_INTERVAL=86400000
# Set to 'true' to auto-apply updates
C3_AUTO_UPDATE=false
C3_UPDATE_STAGING=./data/updates
C3_UPDATE_BACKUP=./data/backups
