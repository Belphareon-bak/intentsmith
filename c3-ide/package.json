{
  "private": true,
  "name": "c3-ide",
  "version": "0.1.0",
  "description": "C3 Studio — AI-powered IDE built on Eclipse Theia",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "applications/*",
    "extensions/*"
  ],
  "scripts": {
    "build": "yarn --cwd applications/electron build",
    "start": "yarn --cwd applications/electron start",
    "watch": "yarn --cwd applications/electron watch",
    "clean": "yarn --cwd applications/electron clean"
  },
  "devDependencies": {
    "typescript": "~5.3.0",
    "rimraf": "^5.0.0"
  }
}
