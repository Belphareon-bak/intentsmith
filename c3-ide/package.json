{
  "private": true,
  "name": "c3-ide",
  "version": "0.1.0",
  "description": "C3 Studio — AI-powered IDE built on Eclipse Theia",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "applications/*",
    "extensions/*"
  ],
  "scripts": {
    "build": "yarn --cwd applications/electron build",
    "start": "yarn --cwd applications/electron start",
    "watch": "yarn --cwd applications/electron watch",
    "clean": "yarn --cwd applications/electron clean"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "postcss": "^8.5.6",
    "rimraf": "^5.0.0",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.3.0"
  }
}
