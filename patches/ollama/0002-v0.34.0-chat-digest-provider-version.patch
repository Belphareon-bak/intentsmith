diff --git a/api/types.go b/api/types.go
index 7ea9022..beeeb85 100644
--- a/api/types.go
+++ b/api/types.go
@@ -521,6 +521,12 @@ type ChatResponse struct {
 	// Model is the model name that generated the response.
 	Model string `json:"model"`
 
+	// Digest is the exact local manifest digest selected for this response.
+	Digest string `json:"digest,omitempty"`
+
+	// ProviderVersion identifies the Ollama build serving this response.
+	ProviderVersion string `json:"provider_version,omitempty"`
+
 	// RemoteModel is the name of the upstream model that generated the response.
 	RemoteModel string `json:"remote_model,omitempty"`
 
