{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionStateSnapshot",
  "type": "object",
  "required": ["execution_id", "meta", "progress"],
  "properties": {
    "execution_id": { "type": "string" },

    "meta": {
      "type": "object",
      "required": ["status", "created_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["created", "running", "paused", "waiting_for_approval", "done", "failed"]
        },
        "created_at": { "type": "string" }
      }
    },

    "progress": {
      "type": "object",
      "required": ["current_step", "completed_steps"],
      "properties": {
        "current_step": { "type": "number" },
        "completed_steps": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    }
  },
  "additionalProperties": true
}
