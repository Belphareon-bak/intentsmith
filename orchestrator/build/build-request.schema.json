{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildRequest",
  "type": "object",
  "required": ["goal", "constraints", "environment", "priority"],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "environment": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["local", "cloud", "hybrid"]
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": ["speed", "stability", "cost"]
    },
    "notes": {
      "type": "string"
    }
  }
}
