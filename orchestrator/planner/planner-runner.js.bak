import { collectContext } from "../runtime/context.js";
import { planWithLLM } from "./planner-llm.js";

function extractPlan(raw) {
  // 1️⃣ Ollama chat wrapper
  if (raw?.message?.content) {
    raw = raw.message.content;
  }

  // 2️⃣ String → JSON
  if (typeof raw === "string") {
    raw = raw
      .replace(/^```[a-zA-Z]*\s*/g, "")
      .replace(/```$/g, "")
      .trim();

    try {
      raw = JSON.parse(raw);
    } catch {
      throw new Error("Planner returned invalid JSON:\n" + raw);
    }
  }

  if (typeof raw !== "object" || raw === null) {
    throw new Error("Planner returned invalid data type");
  }

  // 3️⃣ Normalize steps
  const steps = raw.steps ?? raw.plan;

  if (!Array.isArray(steps)) {
    throw new Error(
      "Planner output invalid: missing steps[] or plan[]\n" +
      JSON.stringify(raw, null, 2)
    );
  }

  return { steps };
}

export async function runPlannerRunner(goal, cfg = {}) {
  const context = collectContext(cfg, goal);

  const raw = await planWithLLM(
    `Goal:\n${goal}\n\nContext:\n${context.join("\n")}`
  );

  return extractPlan(raw);
}
