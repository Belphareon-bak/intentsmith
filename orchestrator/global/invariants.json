{
  "backend_authoritative": true,
  "ui_is_stateless": true,
  "no_ui_logic_in_backend": true,
  "no_project_overrides_global_rules": true,

  "execution": {
    "must_be_resumable": true,
    "must_be_persisted": true,
    "no_hidden_state": true
  },

  "llm": {
    "cannot_write_files_directly": true,
    "cannot_execute_shell": true,
    "outputs_must_be_validated": true
  },

  "approval": {
    "required_for_privileged_steps": true,
    "required_on_consensus_failure": true
  }
}
