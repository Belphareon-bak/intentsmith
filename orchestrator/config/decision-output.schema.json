{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionOutput",
  "type": "object",
  "required": [
    "title",
    "summary",
    "accepted_design",
    "ui_contract",
    "forbidden_actions",
    "assumptions",
    "next_steps"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 20 },

    "accepted_design": {
      "type": "string",
      "minLength": 50,
      "description": "Final accepted design in markdown"
    },

    "ui_contract": {
      "type": "object",
      "required": ["reads_from_backend", "renders", "never_computes"],
      "properties": {
        "reads_from_backend": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "renders": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "never_computes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "forbidden_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 },
      "minItems": 1
    },

    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 },
      "minItems": 1
    },

    "next_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
