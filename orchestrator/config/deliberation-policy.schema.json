{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeliberationPolicy",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["single", "dual_consensus", "custom"]
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "consensus_rule": {
      "type": "string",
      "enum": ["both_pass", "majority", "any_pass"],
      "default": "both_pass"
    },
    "designers": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    },
    "reviewers": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    },
    "stop_on_first_pass": {
      "type": "boolean",
      "default": false
    },
    "bindings": {
      "type": "object",
      "description": "Optional per-policy role override mapping (role -> model id)",
      "additionalProperties": { "type": "string" }
    }
  },
  "required": ["mode"],
  "additionalProperties": false
}
