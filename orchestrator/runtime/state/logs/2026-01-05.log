[2026-01-05T21:37:29.048Z] [DEBUG] [C3:Agent] Tool params: {"path":"/tmp/dual-test/todo.js","content":"#!/usr/bin/env node\n\nconst fs = require('fs');\nconst path = require('path');\n\nconst TODO_FILE = 'todo.json';\n\n// Načtení úkolů z souboru\nfunction loadTodos() {\n  if (!fs.existsSync(TODO_FILE)) {\n    fs.writeFileSync(TODO_FILE, JSON.stringify({ tasks: [] }, null, 2));\n  }\n  return JSON.parse(fs.readFileSync(TODO_FILE));\n}\n\n// Uložení úkolů do souboru\nfunction saveTodos(todos) {\n  fs.writeFileSync(TODO_FILE, JSON.stringify(todos, null, 2));\n}\n\n// Přidání nového úkolu\nfunction addTodo(task) {\n  const todos = loadTodos();\n  todos.tasks.push({ id: Date.now(), text: task, done: false });\n  saveTodos(todos);\n  console.log(`✅ Přidán úkol: ${task}`);\n}\n\n// Výpis všech úkolů\nfunction listTodos() {\n  const todos = loadTodos();\n  if (todos.tasks.length === 0) {\n    console.log('📭 Žádné úkoly');\n    return;\n  }\n\n  console.log('📝 Seznam úkolů:');\n  todos.tasks.forEach((task, index) => {\n    console.log(`[${index + 1}] ${task.text} ${task.done ? '(✅)' : ''}`);\n  });\n}\n\n// Označení úkolu jako hotový\nfunction markDone(index) {\n  const todos = loadTodos();\n  if (index < 0 || index >= todos.tasks.length) {\n    console.error('❌ Neplatný index úkolu');\n    return;\n  }\n\n  todos.tasks[index].done = true;\n  saveTodos(todos);\n  console.log(`✅ Označen jako hotový: ${todos.tasks[index].text}`);\n}\n\n// Hlavní funkce\nfunction main() {\n  if (process.argv.length < 3) {\n    console.log('\\nUsage: node todo.js <command> [args]');\n    console.log('\\nCommands:');\n    console.log('  add <task>      - Přidat nový úkol');\n    console.log('  list          - Vypsat všechny úkoly');\n    console.log('  done <index>  - Označit úkol jako hotový');\n    console.log('\\n');\n    return;\n  }\n\n  const command = process.argv[2];\n  \n  switch (command) {\n    case 'add':\n      if (process.argv.length < 4) {\n        console.error('❌ Chybí název úkolu');\n        return;\n      }\n      addTodo(process.argv[3]);\n      break;\n\n    case 'list':\n      listTodos();\n      break;\n\n    case 'done':\n      if (process.argv.length < 4) {\n        console.error('❌ Chybí index úkolu');\n        return;\n      }\n      markDone(parseInt(process.argv[3]));\n      break;\n\n    default:\n      console.error(`❌ Neznámý příkaz: ${command}`);\n  }\n}\n\nmain();"}
