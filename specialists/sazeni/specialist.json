{
  "id": "sazeni",
  "version": "2.0.0",
  "manifestVersion": 2,
  "name": "Sázkový analytik",
  "description": "Návrhy tiketů z importované nabídky, s limity kurzů, pravděpodobností a času. Fotbal 1X2.",
  "author": "c3-core",
  "domain": "sports_betting",
  "type": "domain",
  "engine": ">=121.0.0",
  "entry": "./index.js",
  "tools": [
    {
      "id": "sazeni.odds_compare",
      "name": "Porovnání kurzů",
      "module": "./tools/betting-engine.js",
      "function": "runBetting"
    },
    {
      "id": "sazeni.match_analysis",
      "name": "Analýza zápasu",
      "module": "./tools/betting-engine.js",
      "function": "runBetting"
    },
    {
      "id": "sazeni.ticket_builder",
      "name": "Sestavení tiketu",
      "module": "./tools/betting-engine.js",
      "function": "runBetting"
    },
    {
      "id": "sazeni.value_finder",
      "name": "Value Bet Finder",
      "module": "./tools/betting-engine.js",
      "function": "runBetting"
    }
  ],
  "capabilities": [
    "betting.odds_compare",
    "betting.match_analysis",
    "betting.ticket_build",
    "betting.value_find"
  ],
  "expertises": [
    "sazeni"
  ],
  "knowledge_packs": [],
  "migrations": [],
  "settings": {
    "default_sport": "football",
    "default_currency": "CZK",
    "default_stake_unit": 100
  },
  "enabledByDefault": true
}
